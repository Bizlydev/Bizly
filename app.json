{
  "expo": {
    "name": "Bizly",
    "slug": "bizlu",
    "version": "1.0.0",
    "owner": "bizlydev",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#0B1120"
    },
    "android": {
      "package": "com.bizlydev.bizly",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B1120"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bizlydev.bizly",
      "buildNumber": "1.0.0"
    },
    "plugins": [
      "expo-router",
      [
        "@mozzius/expo-dynamic-app-icon",
        {
          "default": {
            "ios": "./assets/icon.png",
            "android": "./assets/icon.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d871b9ff-c022-489c-ab3d-e4a4412c6a2f"
      }
    }
  }
}